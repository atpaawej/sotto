{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sotto",
  "version": "0.2.1",
  "identifier": "io.github.atpaawej.Sotto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sotto",
        "width": 920,
        "height": 660,
        "minWidth": 780,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Hold a key, speak, and clean text lands where your cursor is.",
    "longDescription": "An open-source dictation app for Linux. Hold a key, speak, release, and the cleaned text is typed into whatever app is focused.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/Sotto-hidden.desktop",
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "wl-clipboard"],
        "files": {
          "usr/share/applications/io.github.atpaawej.Sotto.desktop": "../packaging/io.github.atpaawej.Sotto.desktop",
          "usr/share/icons/hicolor/32x32/apps/io.github.atpaawej.Sotto.png": "icons/32x32.png",
          "usr/share/icons/hicolor/128x128/apps/io.github.atpaawej.Sotto.png": "icons/128x128.png",
          "usr/share/icons/hicolor/512x512/apps/io.github.atpaawej.Sotto.png": "icons/icon.png"
        }
      }
    }
  }
}
